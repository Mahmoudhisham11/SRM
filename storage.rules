rules_version = '2';

// SRM Voice Log — Storage rules for the original case recordings.
//   srmVoiceLog/shared/audio/{caseId}  any signed-in account, audio only, < 20 MB
//   srmVoiceLog/{uid}/audio/{caseId}   recordings from before the shared space:
//                                      read-only for their owner
// Sharing the bucket with another app? Paste just the two `match /srmVoiceLog/…`
// blocks into your existing `match /b/{bucket}/o { … }`.
service firebase.storage {
  match /b/{bucket}/o {
    match /srmVoiceLog/shared/audio/{caseId} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }
    match /srmVoiceLog/{owner}/audio/{caseId} {
      allow read, delete: if request.auth != null && request.auth.uid == owner && owner != 'shared';
    }
  }
}
